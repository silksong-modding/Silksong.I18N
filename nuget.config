<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    <add key="silksong-modding" value="https://git.silksong-modding.org/api/packages/silksong-modding/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- Older Silksong.* versions only exist on nuget.org; keep it as a source for them. -->
      <package pattern="Silksong.*" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
    <packageSource key="silksong-modding">
      <!-- New versions of org packages are only published to the forge's feed. -->
      <package pattern="Silksong.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
